# Optional local Docker database initialization only. Set your own password.
CARTHOUND_POSTGRES_USER=carthound
CARTHOUND_POSTGRES_PASSWORD=
CARTHOUND_POSTGRES_DB=carthound

# Canonical connection setting; supply a complete URL with your own credentials.
# Compose tooling + local DB: postgresql://USER:PASSWORD@postgres:5432/carthound
# Host tooling + local DB: postgresql://USER:PASSWORD@127.0.0.1:5432/carthound
# External DB: postgresql://USER:PASSWORD@database.example.internal:5432/carthound
DATABASE_URL=

# Export GITHUB_TOKEN in your shell for private package installation/builds.
# Docker receives it only as a BuildKit secret; do not put it in this file.
