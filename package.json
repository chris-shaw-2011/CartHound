{
	"name": "carthound",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@11.19.0",
	"type": "module",
	"engines": {
		"node": ">=26",
		"npm": ">=11"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check": "npm run lint && npm run knip && npm run sherif && npm run build && npm test",
		"format": "eslint . --fix",
		"knip": "knip --config knip.config.ts --reporter compact",
		"lint": "eslint .",
		"sherif": "sherif",
		"test": "vitest run --passWithNoTests"
	},
	"devDependencies": {
		"@chris-shaw-2011/lint": "^1.3.0",
		"@types/node": "^26.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
